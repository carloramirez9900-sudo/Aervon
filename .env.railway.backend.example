# AERVON backend — Railway production template
NODE_ENV=production

# Railway injects PORT automatically. Do not hardcode it in Railway.
# PORT=3000

# Set AFTER the frontend receives its public Railway/custom domain.
# Multiple origins can be comma-separated.
FRONTEND_ORIGINS=https://YOUR-FRONTEND.up.railway.app

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=aervon
MONGODB_MAX_POOL_SIZE=20

# Authentication — generate strong random secrets; never commit real values.
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REGISTRATION_CHALLENGE_TTL_MINUTES=10

# Telegram bot
TELEGRAM_BOT_TOKEN=REPLACE_FROM_BOTFATHER
TELEGRAM_BOT_USERNAME=REPLACE_WITHOUT_AT_SIGN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# BNB Smart Chain
BSC_RPC_URL=https://YOUR-BSC-RPC-ENDPOINT
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_REQUIRED_CONFIRMATIONS=12
# Set this to the current/safe block immediately before enabling deposit monitoring.
BSC_DEPOSIT_START_BLOCK=0

# Deposit address derivation.
# Recommended architecture: xpub for address generation in the API process,
# signer/seed isolated outside the main API in production.
BSC_DEPOSIT_XPUB=REPLACE_WITH_DEPOSIT_XPUB
# Main API contains NO deposit mnemonic. Isolated signer is a separate private Railway service.
BSC_SIGNER_INTERNAL_URL=http://aervon-signer.railway.internal:3001
BSC_SIGNER_SHARED_SECRET=REPLACE_WITH_MATCHING_RANDOM_32_BYTE_OR_LONGER_SECRET
BSC_SIGNER_MAX_GAS_PRICE_GWEI=20
BSC_TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS
BSC_GAS_WALLET_PRIVATE_KEY=

# Withdrawal wallet
BSC_WITHDRAWAL_ADDRESS=0xYOUR_WITHDRAWAL_HOT_WALLET
BSC_WITHDRAWAL_PRIVATE_KEY=
BSC_WITHDRAWAL_GAS_MARGIN_BPS=1500
BSC_WITHDRAWAL_CONFIRMATIONS=12

# Product rules
MIN_DEPOSIT_USDT=5
MIN_WITHDRAWAL_USDT=10

# Market reference API used only for reference pricing in simulated unified trading.
MARKET_REFERENCE_BASE_URL=https://api.binance.com

# First admin bootstrap. Enable only once, after this verified account exists.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_PHONE=+00000000000
